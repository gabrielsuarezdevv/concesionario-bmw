# Docker Compose reads .env. For Maven/Java, export these variables in the terminal.
# Brevo Free: copy the SMTP login and SMTP key from the Brevo dashboard.
# Keep ORDER_MAIL_MODE=preview until a verified sender and valid credentials are set.
ORDER_MAIL_MODE=preview
ORDER_MAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
# Reachable web origin, without a trailing slash. Empty means the current origin.
CHECKOUT_PUBLIC_URL=
